{
  "env": {
    "browser": true,
    "es6": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/eslint-recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:import/recommended",
    "plugin:import/electron",
    "plugin:import/typescript"
  ],
  "parser": "@typescript-eslint/parser",
  "rules": {
    "@typescript-eslint/consistent-type-imports": "error",
    "import/no-cycle": "error"
  },
  "overrides": [
    {
      "files": ["src/renderer/**/*.{ts,tsx}"],
      "rules": {
        "import/no-nodejs-modules": "error",
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "Player Renderer must use the read-only Preload API."
              }
            ],
            "patterns": [
              {
                "group": ["node:*", "**/main/**"],
                "message": "Player Renderer must not depend on Node or Electron Main."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/main/**/*.ts", "src/main.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/renderer/**"],
                "message": "Player Main must not depend on Renderer implementation."
              }
            ]
          }
        ]
      }
    }
  ]
}
