{
  "name": "player",
  "productName": "VN Engine Player",
  "version": "0.1.0",
  "description": "Read-only desktop player for exported VN Engine games",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "node ../../node_modules/@electron-forge/cli/dist/electron-forge.js start",
    "package": "node ../../node_modules/@electron-forge/cli/dist/electron-forge.js package",
    "make": "node ../../node_modules/@electron-forge/cli/dist/electron-forge.js make",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --ext .ts,.tsx .",
    "test": "vitest run && node --test scripts/tests/*.node-test.mjs",
    "test:release-tools": "node --test scripts/tests/*.node-test.mjs",
    "ci:prepare-embedded": "node scripts/prepareEmbeddedFixture.mjs",
    "ci:prepare-embedded-artifact": "node scripts/prepareEmbeddedArtifact.mjs",
    "ci:verify-game-inputs": "node scripts/verifyGameBuildInputs.mjs",
    "ci:verify-build": "node scripts/verifyPlayerBuild.mjs",
    "ci:collect-artifacts": "node scripts/collectPlayerArtifacts.mjs",
    "ci:archive-windows": "node scripts/archiveWindowsBuild.mjs",
    "ci:verify-release-set": "node scripts/verifyReleaseSet.mjs",
    "ci:verify-release-prerequisites": "node scripts/verifyReleasePrerequisites.mjs",
    "ci:locate-build": "node scripts/locatePlayerBuild.mjs",
    "ci:materialize-secret": "node scripts/materializeSecretFile.mjs",
    "ci:stage-template": "node scripts/stagePlayerTemplate.mjs",
    "ci:run-editor-with-template": "node scripts/runEditorWithPlayerTemplate.mjs",
    "ci:verify-editor-template": "node scripts/verifyPackagedEditorTemplate.mjs",
    "ci:sign-build": "node scripts/signPlayerBuild.mjs"
  },
  "author": {
    "name": "Hongyi Ding",
    "email": "dinghongyi8@gmail.com"
  },
  "license": "MIT",
  "dependencies": {
    "@vnengine/player-ui": "workspace:*",
    "@vnengine/runtime": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/asar": "3.4.1",
    "@electron/fuses": "1.8.0",
    "@electron/osx-sign": "1.3.3",
    "@electron/windows-sign": "1.2.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "43.2.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "filenamify": "4.3.0",
    "jsdom": "27.4.0",
    "typescript": "~5.9.3",
    "vite": "^5.4.21",
    "vite-node": "3.2.4",
    "vitest": "3.2.7"
  }
}
