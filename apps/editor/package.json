{
  "name": "editor",
  "productName": "VN Engine Editor",
  "version": "1.0.0",
  "description": "A visual novel editor powered by React and C++20",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "engine:configure": "cmake -S ../../engine -B ../../engine/build -DCMAKE_BUILD_TYPE=Debug -DBUILD_TESTING=ON",
    "engine:build": "pnpm run engine:configure && cmake --build ../../engine/build --parallel",
    "engine:test": "ctest --test-dir ../../engine/build --output-on-failure",
    "engine:configure:release": "cmake -S ../../engine -B ../../engine/build-release -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF",
    "engine:build:release": "pnpm run engine:configure:release && cmake --build ../../engine/build-release --config Release --target vn_engine_backend --parallel",
    "engine:stage:release": "pnpm run engine:build:release && cmake --install ../../engine/build-release --config Release --prefix ../../engine/stage/backend",
    "start": "pnpm run engine:build && node ../player/scripts/runEditorWithPlayerTemplate.mjs --command start",
    "package": "pnpm run engine:stage:release && node ../player/scripts/runEditorWithPlayerTemplate.mjs --command package",
    "package:application": "node ../player/scripts/runEditorWithPlayerTemplate.mjs --command package",
    "make": "pnpm run engine:stage:release && node ../player/scripts/runEditorWithPlayerTemplate.mjs --command make",
    "publish": "pnpm run engine:stage:release && node ../player/scripts/runEditorWithPlayerTemplate.mjs --command publish",
    "test:release-tools": "node --test scripts/tests/*.node-test.mjs",
    "lint": "eslint --ext .ts,.tsx .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run engine:build && pnpm run engine:test && vitest run",
    "test:integration": "pnpm run engine:build && vitest run tests/integration",
    "test:watch": "vitest"
  },
  "author": {
    "name": "Hongyi Ding",
    "email": "dinghongyi8@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "1.8.0",
    "@electron/asar": "3.4.1",
    "@electron/osx-sign": "1.3.3",
    "@electron/windows-sign": "1.2.2",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "43.2.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "typescript": "~5.9.3",
    "vite": "^5.4.21",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@vnengine/player-ui": "workspace:*",
    "@vnengine/runtime": "workspace:*",
    "blockly": "13.1.1",
    "electron-squirrel-startup": "1.0.1",
    "filenamify": "4.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  }
}
